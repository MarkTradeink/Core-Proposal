{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cifral.io/schemas/pricing.schema.json",
  "title": "Module 3 — Pricing & commercial logic output",
  "description": "Output envelope of 03-pricing-commercial-logic. Numbers are in the client's currency, rounded to 2 decimals. Percentages are fractions (0.15 == 15%).",
  "type": "object",
  "required": ["client_id", "data", "status"],
  "additionalProperties": true,
  "properties": {
    "client_id": { "type": "string", "minLength": 1 },
    "client_config": { "type": ["object", "null"] },
    "status": { "type": "string", "enum": ["ok", "incomplete", "error"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "data": {
      "type": "object",
      "required": ["subtotal", "margin_pct", "risk_pct", "discount_pct", "total", "payment_terms"],
      "additionalProperties": true,
      "properties": {
        "subtotal": { "type": "number", "minimum": 0, "description": "materials_cost + sum(hours * rate), before risk/margin/discount multipliers." },
        "margin_pct": { "type": "number", "minimum": 0 },
        "risk_pct": { "type": "number", "minimum": 0 },
        "discount_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "total": { "type": "number", "minimum": 0 },
        "payment_terms": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "description": "Optional ISO currency code (e.g. EUR)." }
      }
    }
  }
}
